{
  "name": "lm-fe",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:env && ng serve",
    "build": "npm run build:env && ng build",
    "watch": "npm run build:env && ng build --watch --configuration development",
    "test": "npm run build:env && ng test && vitest run --config vitest.tools.config.mts",
    "build:env": "node tools/site-environment.mjs",
    "build:manifest": "node tools/catalog-manifest.mjs",
    "build:artifacts": "node tools/site-artifacts.mjs",
    "build:checks": "node tools/site-checks.mjs",
    "build:site": "npm run build:manifest && npm run build && npm run build:artifacts && npm run build:checks"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
